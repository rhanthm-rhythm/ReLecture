# --- Required ---

# LLM for transcript transformation (any OpenAI-compatible endpoint)
NEBIUS_API_KEY="your-nebius-api-key"
# LLM_BASE_URL="https://api.studio.nebius.com/v1/"
# LLM_MODEL_NAME="openai/gpt-oss-120b"

# --- TTS backends (start the one you need) ---

# QWEN3_TTS_ENDPOINT="http://localhost:5000"
# CHATTERBOX_ENDPOINT="http://localhost:5002"
# COSYVOICE_ENDPOINT="http://localhost:5003"

# --- Whisper transcription server ---

# WHISPER_ENDPOINT="http://localhost:5001/transcribe"

# --- Vision model (only for visual_impairment accessibility mode) ---

# VISION_BASE_URL="http://localhost:8005/v1"
# VISION_MODEL_NAME="Qwen/Qwen3-VL-8B-Instruct"
# VISION_API_KEY="EMPTY"

# --- Ground-truth regeneration only (NOT needed to run the pipeline) ---
# The ground-truth transcriptions in eval_results/groundtruth/ are already
# committed to this repo. A Gemini key is only needed if you want to
# re-run scripts/groundtruth/ to regenerate them from scratch.
# GEMINI_API_KEY="your-gemini-api-key"
